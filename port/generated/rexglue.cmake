# Configure a rexglue target with SDK libraries and platform settings.
#
# Usage:
#   rexglue_setup_target(<target> [GPU_PLUGINS xenos])
#
macro(rexglue_setup_target target_name)

    if(REXGLUE_ENTRYPOINT_GENERATED_SOURCES)

        add_library(
            ${target_name}_recomp
            OBJECT
            ${REXGLUE_ENTRYPOINT_GENERATED_SOURCES}
        )

        target_include_directories(
            ${target_name}_recomp
            PRIVATE
            ${CMAKE_CURRENT_SOURCE_DIR}
            ${CMAKE_CURRENT_SOURCE_DIR}/src
            ${REXGLUE_ENTRYPOINT_INCLUDE_DIR}
        )

        target_link_libraries(
            ${target_name}_recomp
            PRIVATE
            rex::runtime
        )

        # Apply the SDK's normal target configuration first.
        rexglue_apply_target_settings(
            ${target_name}_recomp
        )

        # Then apply generated-code/PCH/EH/ARM64 optimization settings.
        rexglue_apply_recomp_settings(
            ${target_name}_recomp
            "${REXGLUE_ENTRYPOINT_INCLUDE_DIR}/sonicgenerations_pch.h"
        )

        add_dependencies(
            ${target_name}_recomp
            sonicgenerations_codegen
        )

        target_link_libraries(
            ${target_name}
            PRIVATE
            ${target_name}_recomp
        )

    endif()


    # Also on the host, so a tree that has never run codegen still
    # generates it.

    add_dependencies(
        ${target_name}
        sonicgenerations_codegen
    )


    target_include_directories(
        ${target_name}
        PRIVATE
        ${CMAKE_CURRENT_SOURCE_DIR}
        ${CMAKE_CURRENT_SOURCE_DIR}/src
        ${REXGLUE_ENTRYPOINT_INCLUDE_DIR}
    )


    target_link_libraries(
        ${target_name}
        PRIVATE
        rex::runtime
    )


    # Embed metadata/icons when available.

    if(
        EXISTS
        "${CMAKE_CURRENT_SOURCE_DIR}/metadata/icons"
    )

        rexglue_embed_metadata(
            ${target_name}
            DIRECTORY
            "${CMAKE_CURRENT_SOURCE_DIR}/metadata/icons"
            PREFIX
            "icons"
        )

    endif()


    rexglue_configure_target(
        ${target_name}
        ${ARGN}
    )

endmacro()


